# Atlas Environment Variables Template
# Copy this file to '.env.local' and fill in your secrets.

# ==========================================
# 🌐 Application Settings
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# ⚡ Supabase Settings
# ==========================================
# Public variables accessible on both client and server:
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private secret key accessible ONLY on the server (never expose to client):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# 🤖 Google GenAI (Gemini) Settings
# ==========================================
# API key for the Google GenAI SDK (Gemini models):
GEMINI_API_KEY=AIzaSy...
